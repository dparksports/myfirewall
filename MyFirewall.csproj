<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>5.7.25</Version>
    <AssemblyVersion>5.7.25.0</AssemblyVersion>
    <FileVersion>5.7.25.0</FileVersion>
    <DefaultItemExcludes>MyFirewall.Desktop\**;TestFw\**;testcom\**;Test*.cs;$(DefaultItemExcludes)</DefaultItemExcludes>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.2" />
    <PackageReference Include="Spectre.Console" Version="0.55.2" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.8" />
  </ItemGroup>

  <Target Name="CopyManifestSidecar" AfterTargets="Publish">
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\app.manifest"
      DestinationFiles="$(PublishDir)$(AssemblyName).exe.manifest"
      SkipUnchangedFiles="false" />
    <Message Importance="high"
      Text="[UAC Fix] Copied app.manifest -> $(PublishDir)$(AssemblyName).exe.manifest" />
  </Target>

</Project>
